@model LifeNetAssist.MVC.Models.SupervisorProfile

@{
    ViewData["Title"] = "Supervisor Profile";
}

<div class="container mt-4" style="max-width: 700px;">
    <a asp-action="Dashboard" class="btn btn-sm btn-outline-secondary mb-3">&larr; Back</a>
    <h2 class="mb-4">My Supervisor Profile</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <form asp-action="Profile" method="post" class="card p-4 shadow-sm bg-white rounded">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="UserId" />

        <div class="mb-3">
            <label asp-for="Designation" class="form-label">Designation</label>
            <select asp-for="Designation" class="form-select">
                <option value="">-- Select --</option>
                <option value="Lecturer">Lecturer</option>
                <option value="Assistant Professor">Assistant Professor</option>
                <option value="Associate Professor">Associate Professor</option>
                <option value="Professor">Professor</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="ResearchAreas" class="form-label">Research Areas</label>
            <input asp-for="ResearchAreas" class="form-control" placeholder="e.g. Machine Learning, Medical Imaging" />
        </div>

        <div class="mb-3">
            <label asp-for="OfficeRoom" class="form-label">Office Room</label>
            <input asp-for="OfficeRoom" class="form-control" placeholder="e.g. Room 402, CSE Building" />
        </div>

        <div class="mb-3">
            <label asp-for="MaxStudents" class="form-label">Maximum Students</label>
            <input asp-for="MaxStudents" type="number" min="1" max="30" class="form-control" />
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsAvailable" class="form-check-input" type="checkbox" />
            <label asp-for="IsAvailable" class="form-check-label">Available to take new students</label>
        </div>

        <button type="submit" class="btn btn-primary">Save Profile</button>
    </form>
</div>
