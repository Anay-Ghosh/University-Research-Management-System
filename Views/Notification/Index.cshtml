@model List<LifeNetAssist.MVC.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
}

<div class="container mt-4" style="max-width: 750px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Notifications</h2>
        @if (Model.Any(n => !n.IsRead))
        {
            <form asp-action="MarkAllRead" method="post">
                <button type="submit" class="btn btn-sm btn-outline-secondary">Mark all as read</button>
            </form>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">You have no notifications.</div>
    }
    else
    {
        <div class="list-group shadow-sm">
        @foreach (var n in Model)
        {
            <a asp-action="Open" asp-route-id="@n.Id"
               class="list-group-item list-group-item-action py-3 @(n.IsRead ? "" : "bg-light")">
                <div class="d-flex justify-content-between">
                    <div>
                        @if (!n.IsRead)
                        {
                            <span class="badge bg-primary me-2">New</span>
                        }
                        <span>@n.Message</span>
                    </div>
                    <span class="text-muted small text-nowrap ms-3">@n.CreatedAt.ToString("dd MMM, hh:mm tt")</span>
                </div>
            </a>
        }
        </div>
    }
</div>
