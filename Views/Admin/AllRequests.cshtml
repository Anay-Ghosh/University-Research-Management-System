@model List<LifeNetAssist.MVC.Models.RequestWithVolunteerViewModel>

<div class="container-fluid mt-4">
    <h2 class="text-center mb-4" style="color: #2c3e50; font-weight: 600;">
        @ViewData["Title"]
    </h2>

    <div class="table-responsive shadow-sm rounded-3">
        <table class="table table-hover align-middle mb-0" style="background-color: #ffffff;">
            <thead class="table-dark text-center">
                <tr>
                    <th>ID</th>
                    <th>Requester Name</th>
                    <th>Request Type</th>
                    <th>Location</th>
                    <th>Contact</th>
                    <th>Status</th>
                    <th>Assigned Volunteer</th>
                    <th>Distance (km)</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody class="text-center">
                @if (Model != null && Model.Count > 0)
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Request.Id</td>
                            <td>@item.Request.RequesterName</td>
                            <td>@item.Request.RequestType</td>
                            <td>@item.Request.Location</td>
                            <td>@item.Request.Contact</td>
                            <td>
                                @switch (item.Request.Status)
                                {
                                    case "Pending":
                                        <span class="badge bg-warning text-dark">Pending</span>
                                        break;
                                    case "Assigned":
                                        <span class="badge bg-primary">In Process</span>
                                        break;
                                    case "Completed":
                                        <span class="badge bg-success">Completed</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">Unknown</span>
                                        break;
                                }
                            </td>
                            <td>
                                @if (item.AssignedVolunteer != null)
                                {
                                    @item.AssignedVolunteer.Name
                                }
                                else
                                {
                                    <span class="text-muted">Not Assigned</span>
                                }
                            </td>
                            <td>
                                @(item.DistanceKm.HasValue? item.DistanceKm.Value.ToString("F2") : "-")
                            </td>
                            <td>
                                @if (item.Request.Status == "Pending")
                                {
                                    <a asp-action="AssignVolunteer" asp-route-requestId="@item.Request.Id" class="btn btn-sm btn-primary rounded-pill">
                                        Assign Volunteer
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">No Action</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-3">No requests found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    body {
        font-family: 'Poppins', sans-serif;
        background-color: #f6f9fc;
    }

    table th, table td {
        vertical-align: middle;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.05);
        transition: background-color 0.2s;
    }

    .badge {
        font-weight: 500;
        padding: 0.5em 0.75em;
        border-radius: 0.5rem;
    }

    .btn-sm {
        font-weight: 500;
        padding: 0.35rem 0.75rem;
    }

    .table-responsive {
        border-radius: 0.5rem;
        overflow: hidden;
    }

    h2 {
        font-weight: 600;
    }
</style>
