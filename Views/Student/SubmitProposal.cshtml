@model LifeNetAssist.MVC.Models.ResearchProposal

@{
    ViewData["Title"] = "Submit Proposal";
}

<div class="container mt-4" style="max-width: 700px;">
    <h2 class="mb-4">Submit Research Proposal</h2>

    <form asp-action="SubmitProposal" method="post" class="card p-4 shadow-sm bg-white rounded">
        <div class="mb-3">
            <label asp-for="Title" class="form-label">Research Title</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Abstract" class="form-label">Abstract</label>
            <textarea asp-for="Abstract" class="form-control" rows="6"></textarea>
            <span asp-validation-for="Abstract" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Keywords" class="form-label">Keywords</label>
            <input asp-for="Keywords" class="form-control" placeholder="e.g. deep learning, MRI, classification" />
        </div>

        <div class="mb-3">
            <label asp-for="GitHubRepoUrl" class="form-label">GitHub Repository URL (optional)</label>
            <input asp-for="GitHubRepoUrl" class="form-control" placeholder="https://github.com/username/repo" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Submit Proposal</button>
            <a asp-action="Dashboard" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
