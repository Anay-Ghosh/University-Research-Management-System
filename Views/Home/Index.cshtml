@{
    ViewData["Title"] = "Home Page";
}

<div class="container py-5">
    <!-- Hero Section -->
    <div class="row align-items-center">
        <div class="col-lg-6 text-center text-lg-start">
            <h1 class="display-4 fw-bold mb-4" style="color: #2c3e50;">
                Welcome to <span class="text-success">LifeNet Assist</span>
            </h1>
            <p class="lead mb-4 text-secondary">
                A Smart Volunteer & Emergency Response System designed to connect volunteers, manage help requests, and save lives efficiently.
            </p>

            <!-- Call to Action Buttons -->
            <div class="d-flex flex-column flex-sm-row gap-3">
                <a asp-controller="User" asp-action="Register" class="btn btn-success btn-lg shadow-sm">
                    Register
                </a>
                <a asp-controller="User" asp-action="Login" class="btn btn-primary btn-lg shadow-sm">
                    Login
                </a>
            </div>

            <!-- Optional Info -->
            <p class="mt-4 text-muted">
                Choose your role during registration: Admin, Requester, or Volunteer.
            </p>
        </div>

        <!-- Hero Image / Illustration -->
        <div class="col-lg-6 text-center mt-5 mt-lg-0">
            <img src="~/images/volunteer-hero.png" class="img-fluid" alt="LifeNet Assist Hero" style="max-height: 400px; border-radius: 15px; box-shadow: 0 8px 20px rgba(0,0,0,0.15);">
        </div>
    </div>
</div>

<!-- Optional Custom Styling -->
<style>
    body {
        background: linear-gradient(to right, #e0f7e9, #ffffff);
        font-family: 'Poppins', sans-serif;
    }

    h1 span.text-success {
        color: #28a745;
    }

    .btn-lg {
        padding: 0.8rem 2.2rem;
        font-size: 1.2rem;
        border-radius: 50px;
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .btn-lg:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(0,0,0,0.2);
        }

    .lead {
        font-size: 1.2rem;
    }
</style>
