@model List<LifeNetAssist.MVC.Models.ResearchProposal>

@{
    ViewData["Title"] = "Available Proposals";
}

<div class="container mt-4">
    <a asp-action="Dashboard" class="btn btn-sm btn-outline-secondary mb-3">&larr; Back</a>
    <h2 class="mb-4">Unassigned Research Proposals</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">There are no unassigned proposals right now.</div>
    }
    else
    {
        foreach (var p in Model)
        {
            <div class="card p-4 mb-3 bg-white shadow-sm">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h5>@p.Title</h5>
                        <p class="text-muted mb-1">
                            By @(p.Student != null ? p.Student.Name : "-")
                            @if (p.Student != null && !string.IsNullOrEmpty(p.Student.Department))
                            {
                                <text>&nbsp;|&nbsp; @p.Student.Department</text>
                            }
                        </p>
                        <p class="mb-1"><strong>Keywords:</strong> @(string.IsNullOrEmpty(p.Keywords) ? "-" : p.Keywords)</p>
                        <p class="mb-0">@p.Abstract</p>
                    </div>
                    <form asp-action="Accept" method="post" class="ms-3">
                        <input type="hidden" name="id" value="@p.Id" />
                        <button type="submit" class="btn btn-primary">Accept</button>
                    </form>
                </div>
            </div>
        }
    }
</div>
