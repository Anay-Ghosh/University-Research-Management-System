@model LifeNetAssist.MVC.Models.VolunteerDashboardViewModel

@{
    ViewData["Title"] = "Volunteer Dashboard";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="mb-4">
        <h3 class="fw-semibold mb-1">Volunteer Dashboard</h3>
        <p class="text-muted small mb-0">
            Overview of your assigned requests and profile status
        </p>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Profile Warning -->
    @if (!Model.ProfileExists || Model.Location == "Not set")
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center shadow-sm">
            <span class="small">
                Your volunteer profile is incomplete. Please update your location.
            </span>
            <a asp-action="EditProfile" class="btn btn-sm btn-outline-primary">
                Update Profile
            </a>
        </div>
    }

    <!-- Action Buttons -->
    <div class="card shadow-sm mb-4">
        <div class="card-body d-flex gap-2">
            <a asp-action="EditProfile" class="btn btn-outline-primary btn-sm">
                Edit Profile
            </a>
            <a asp-action="MyTasks" class="btn btn-outline-secondary btn-sm">
                View Assigned Tasks
            </a>
        </div>
    </div>

    <!-- Dashboard Cards -->
    <div class="row g-4">

        <div class="col-md-3">
            <a asp-action="MyTasks" class="text-decoration-none">
                <div class="stat-card">
                    <div class="card-body text-center">
                        <div class="stat-number">@Model.TotalAssignedRequests</div>
                        <div class="stat-label">Total Assigned Requests</div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-3">
            <a asp-action="MyTasks" asp-route-status="Pending" class="text-decoration-none">
                <div class="stat-card">
                    <div class="card-body text-center">
                        <div class="stat-number">@Model.PendingRequests</div>
                        <div class="stat-label">Pending Requests</div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-3">
            <a asp-action="MyTasks" asp-route-status="Completed" class="text-decoration-none">
                <div class="stat-card">
                    <div class="card-body text-center">
                        <div class="stat-number">@Model.CompletedRequests</div>
                        <div class="stat-label">Completed Requests</div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-3">
            <a asp-action="EditProfile" class="text-decoration-none">
                <div class="stat-card">
                    <div class="card-body text-center">
                        <div class="stat-number fs-6">@Model.Location</div>
                        <div class="stat-label">Current Location</div>
                    </div>
                </div>
            </a>
        </div>

    </div>
</div>

<style>
    .stat-card {
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        transition: all 0.2s ease;
    }

        .stat-card:hover {
            box-shadow: 0 6px 14px rgba(0,0,0,0.12);
            transform: translateY(-2px);
        }

    .stat-number {
        font-size: 2rem;
        font-weight: 600;
        color: #1f2937;
    }

    .stat-label {
        font-size: 0.85rem;
        color: #6b7280;
        margin-top: 4px;
    }
</style>
