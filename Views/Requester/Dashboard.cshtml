@model List<LifeNetAssist.MVC.Models.HelpRequest>

@{
    ViewData["Title"] = "Requester Dashboard";
}

<div class="container mt-5">
    <h2 class="mb-4 text-center" style="color: #2c3e50;">My Help Requests</h2>

    <!-- Success/Error Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Create New Request Button -->
    <div class="mb-4 d-flex justify-content-end">
        <a asp-action="Create" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-circle"></i> Create New Request
        </a>
    </div>

    <!-- Requests Table -->
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle mb-0 bg-white">
            <thead class="table-light text-center text-uppercase small">
                <tr>
                    <th class="fw-bold">Request Type</th>
                    <th class="fw-bold">Location</th>
                    <th class="fw-bold">Status</th>
                    <th class="fw-bold">Contact</th>
                    <th class="fw-bold">Actions</th>
                </tr>
            </thead>
            <tbody class="text-center">
                @foreach (var req in Model)
                {
                    <tr>
                        <td>@req.RequestType</td>
                        <td>@req.Location</td>
                        <td>
                            <span class="badge
                                    @(req.Status == "Pending" ? "bg-warning text-dark" :
                                                                    req.Status == "Completed" ? "bg-success" :
                                                                    "bg-secondary")">
                            @req.Status
                        </span>
                    </td>
                    <td>@req.Contact</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@req.Id" class="btn btn-primary btn-sm me-1 shadow-sm">
                            <i class="bi bi-pencil-square"></i> Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@req.Id" class="btn btn-danger btn-sm shadow-sm"
                           onclick="return confirm('Are you sure you want to delete this request?');">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    </td>
                </tr>
                                }
            </tbody>
        </table>
    </div>
</div>

<!-- Optional custom styling -->
<style>
    body {
        font-family: 'Poppins', sans-serif;
        background: #f9f9f9;
    }

    h2 {
        font-weight: 600;
    }

    .table th {
        letter-spacing: 0.05em;
    }

    .btn {
        border-radius: 0.35rem;
        font-weight: 500;
    }

    .table-hover tbody tr:hover {
        background-color: #f1f1f1;
    }
</style>

<!-- Bootstrap Icons CDN (for pencil, trash, plus icons) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
