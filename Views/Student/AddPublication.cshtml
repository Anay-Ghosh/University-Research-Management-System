@model LifeNetAssist.MVC.Models.Publication

@{
    ViewData["Title"] = "Add Publication";
    var myProposals = ViewBag.MyProposals as List<LifeNetAssist.MVC.Models.ResearchProposal>;
}

<div class="container mt-4" style="max-width: 700px;">
    <a asp-action="Publications" class="btn btn-sm btn-outline-secondary mb-3">&larr; Back</a>
    <h2 class="mb-4">Record a Publication</h2>

    <form asp-action="AddPublication" method="post" class="card p-4 shadow-sm bg-white rounded">
        <div class="mb-3">
            <label asp-for="Title" class="form-label">Publication Title</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Authors" class="form-label">Authors</label>
            <input asp-for="Authors" class="form-control" placeholder="e.g. A. Rahman, S. Islam, M. Karim" />
            <span asp-validation-for="Authors" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Type" class="form-label">Type</label>
            <select asp-for="Type" class="form-select">
                <option value="">-- Select --</option>
                <option value="Journal">Journal</option>
                <option value="Conference">Conference</option>
                <option value="Thesis">Thesis</option>
                <option value="Book Chapter">Book Chapter</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Venue" class="form-label">Journal / Conference Name</label>
            <input asp-for="Venue" class="form-control" placeholder="e.g. IEEE Access" />
        </div>

        <div class="mb-3">
            <label asp-for="Year" class="form-label">Year</label>
            <input asp-for="Year" type="number" min="1950" max="2100" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="DOI" class="form-label">DOI (optional)</label>
            <input asp-for="DOI" class="form-control" placeholder="e.g. 10.1109/ACCESS.2026.1234567" />
        </div>

        <div class="mb-3">
            <label asp-for="Url" class="form-label">Link (optional)</label>
            <input asp-for="Url" class="form-control" placeholder="https://..." />
        </div>

        <div class="mb-3">
            <label asp-for="ProposalId" class="form-label">Related Research (optional)</label>
            <select asp-for="ProposalId" class="form-select">
                <option value="">-- None --</option>
                @if (myProposals != null)
                {
                    foreach (var p in myProposals)
                    {
                        <option value="@p.Id">@p.Title</option>
                    }
                }
            </select>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save Publication</button>
            <a asp-action="Publications" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
