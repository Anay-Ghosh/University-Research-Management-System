@model List<LifeNetAssist.MVC.Models.User>

<div class="container-fluid mt-4">
    <h2 class="text-center mb-4" style="color: #2c3e50; font-weight: 600;">
        Volunteers
    </h2>

    <div class="table-responsive shadow-sm rounded-3">
        <table class="table table-hover align-middle mb-0" style="background-color: #ffffff;">
            <thead class="table-dark text-center">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Location</th>
                    <th>Coordinates</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody class="text-center">
                @if (Model != null && Model.Count > 0)
                {
                    foreach (var volunteer in Model)
                    {
                        <tr>
                            <td>@volunteer.Name</td>
                            <td>@volunteer.Email</td>
                            <td>@(volunteer.VolunteerProfile?.Location ?? "-")</td>
                            <td>
                                @(volunteer.VolunteerProfile != null
                                                        ? $"{volunteer.VolunteerProfile.Latitude}, {volunteer.VolunteerProfile.Longitude}"
                                                        : "-")
                    </td>
                    <td>
                        <a asp-action="DeleteVolunteer" asp-route-id="@volunteer.Id"
                           class="btn btn-sm btn-danger rounded-pill mb-1"
                           onclick="return confirm('Are you sure you want to delete this volunteer?');">Delete</a>
                    </td>
                </tr>
                                }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-3">No volunteers found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    body {
        font-family: 'Poppins', sans-serif;
        background-color: #f6f9fc;
    }

    table th, table td {
        vertical-align: middle;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.05);
        transition: background-color 0.2s;
    }

    .btn-sm {
        font-weight: 500;
        padding: 0.35rem 0.75rem;
    }

    .rounded-pill {
        border-radius: 50px !important;
    }

    .table-responsive {
        border-radius: 0.5rem;
        overflow: hidden;
    }

    h2 {
        font-weight: 600;
    }
</style>
