@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Admin Dashboard</h2>
        <div class="d-flex gap-2">
            <a asp-action="Users" class="btn btn-outline-primary">Manage Users</a>
            <a asp-action="Proposals" class="btn btn-outline-primary">All Proposals</a>
            <a asp-action="Publications" class="btn btn-outline-primary">Publications</a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-3">
            <div class="card p-3 shadow-sm bg-white text-center">
                <h6 class="text-muted">Total Users</h6>
                <h3>@ViewBag.TotalUsers</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 shadow-sm bg-white text-center">
                <h6 class="text-muted">Students</h6>
                <h3>@ViewBag.TotalStudents</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 shadow-sm bg-white text-center">
                <h6 class="text-muted">Supervisors</h6>
                <h3>@ViewBag.TotalSupervisors</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 shadow-sm bg-white text-center">
                <h6 class="text-muted">Publications</h6>
                <h3>@ViewBag.TotalPublications</h3>
            </div>
        </div>
    </div>

    <h5 class="mt-4 mb-3">Research Overview</h5>
    <div class="row g-3">
        <div class="col-md-3">
            <div class="card p-3 shadow-sm bg-white text-center">
                <h6 class="text-muted">Total Proposals</h6>
                <h3>@ViewBag.TotalProposals</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 shadow-sm bg-white text-center">
                <h6 class="text-muted">Pending</h6>
                <h3>@ViewBag.PendingProposals</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 shadow-sm bg-white text-center">
                <h6 class="text-muted">Ongoing</h6>
                <h3>@ViewBag.OngoingProposals</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 shadow-sm bg-white text-center">
                <h6 class="text-muted">Completed</h6>
                <h3>@ViewBag.CompletedProposals</h3>
            </div>
        </div>
    </div>
</div>
