@model List<LifeNetAssist.MVC.Models.HelpRequest>

@{
    ViewData["Title"] = "My Assigned Tasks";
}

<h2 class="mb-4">
    My Assigned Tasks
    @if (ViewBag.Filter != null)
    {
        <span>- @ViewBag.Filter</span>
    }
</h2>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Requester</th>
            <th>Type</th>
            <th>Location</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="5" class="text-center text-muted">
                    No tasks found.
                </td>
            </tr>
        }
        else
        {
            foreach (var task in Model)
            {
                <tr>
                    <td>@task.RequesterName</td>
                    <td>@task.RequestType</td>
                    <td>@task.Location</td>
                    <td>
                        <span class="badge @(task.Status == "Completed" ? "bg-success" :
                                                                           task.Status == "Assigned" ? "bg-primary" :
                                                                           "bg-warning")">
                    @task.Status
                </span>
            </td>
            <td>
                @* Show Complete button only for Assigned tasks *@
                @if (task.Status == "Assigned")
                        {
                            <form asp-action="CompleteTask" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@task.Id" />
                                <button type="submit" class="btn btn-sm btn-success">Mark Completed</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
