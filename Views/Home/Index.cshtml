@{
    ViewData["Title"] = "Home";
    var role = Context.Session.GetString("UserRole");
}

<div class="container">
    <div class="text-center py-5">
        <h1 class="fw-bold" style="color:#1e3a5f;">University Research Management System</h1>
        <p class="lead text-muted">Submit proposals, track research progress, and manage supervision in one place.</p>

        @if (role == null)
        {
            <div class="mt-4">
                <a asp-controller="User" asp-action="Register" class="btn btn-primary btn-lg me-2">Get Started</a>
                <a asp-controller="User" asp-action="Login" class="btn btn-outline-secondary btn-lg">Login</a>
            </div>
        }
        else if (role == "Student")
        {
            <a asp-controller="Student" asp-action="Dashboard" class="btn btn-primary btn-lg mt-4">Go to My Research</a>
        }
        else if (role == "Supervisor")
        {
            <a asp-controller="Supervisor" asp-action="Dashboard" class="btn btn-primary btn-lg mt-4">Go to My Students</a>
        }
        else if (role == "Admin")
        {
            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-primary btn-lg mt-4">Go to Dashboard</a>
        }
    </div>

    <div class="row g-4 mt-2">
        <div class="col-md-4">
            <div class="card p-4 shadow-sm bg-white h-100">
                <h5>For Students</h5>
                <p class="text-muted mb-0">Submit research proposals, log progress updates, link your GitHub repository, and receive supervisor feedback.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-4 shadow-sm bg-white h-100">
                <h5>For Supervisors</h5>
                <p class="text-muted mb-0">Browse open proposals, accept students, monitor their progress, and record reviews.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-4 shadow-sm bg-white h-100">
                <h5>For Administrators</h5>
                <p class="text-muted mb-0">Oversee all users, assign supervisors, and track institutional research output and publications.</p>
            </div>
        </div>
    </div>
</div>
