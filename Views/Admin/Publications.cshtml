@model List<LifeNetAssist.MVC.Models.Publication>

@{
    ViewData["Title"] = "Publications";
}

<div class="container mt-4">
    <a asp-action="Dashboard" class="btn btn-sm btn-outline-secondary mb-3">&larr; Back</a>
    <h2 class="mb-4">Research Publications</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No publications recorded yet.</div>
    }
    else
    {
        <table class="table table-hover align-middle bg-white shadow-sm">
            <thead class="table-light">
                <tr>
                    <th>Title</th>
                    <th>Authors</th>
                    <th>Venue</th>
                    <th>Type</th>
                    <th>Year</th>
                    <th>Added By</th>
                    <th>Link</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Title</td>
                    <td>@p.Authors</td>
                    <td>@(string.IsNullOrEmpty(p.Venue) ? "-" : p.Venue)</td>
                    <td>@(string.IsNullOrEmpty(p.Type) ? "-" : p.Type)</td>
                    <td>@(p.Year.HasValue ? p.Year.ToString() : "-")</td>
                    <td>@(p.Student != null ? p.Student.Name : "-")</td>
                    <td>
                        @if (!string.IsNullOrEmpty(p.Url))
                        {
                            <a href="@p.Url" target="_blank" class="btn btn-sm btn-outline-primary">Open</a>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
